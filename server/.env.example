# Server Production / Local Environment Variables
# PORT: Supplied automatically by Render in production (defaults to 4000 locally)
PORT=4000

# CLIENT_URL: Allowed CORS origin(s), comma-separated without trailing slashes
# In local dev: http://localhost:5173
# On Render: https://your-sketchclub.vercel.app
CLIENT_URL=http://localhost:5173

# NODE_ENV: production on Render, development locally
NODE_ENV=development
